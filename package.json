{
  "name": "callpython",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "node scripts/dev-runner.mjs",
    "dev:full": "node scripts/dev-runner.mjs --full",
    "dev:all": "npm run web:build && npm run dev:full",
    "web:dev": "vite --config vite.config.mts",
    "web:build": "vite build --config vite.config.mts",
    "web:preview": "vite preview --config vite.config.mts",
    "build:server": "tsc -p tsconfig.server.json",
    "watch:server": "tsc -w -p tsconfig.server.json",
    "serve:server": "nodemon --watch dist/server.js --ext js dist/server.js",
    "peerjs": "peerjs --port 3001 --path / --sslkey certs/key.pem --sslcert certs/cert.pem",
    "api": "python api/server.py",
    "typecheck": "tsc -p web/tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "chart.js": "4.5.1",
    "chartjs-adapter-date-fns": "3.0.0",
    "chartjs-plugin-datalabels": "2.2.0",
    "express": "^5.2.1",
    "peer": "1.0.2",
    "peerjs": "1.5.5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "nodemon": "3.1.14",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  }
}
